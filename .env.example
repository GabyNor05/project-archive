# Copy to .env (which is git-ignored) and fill in. NEVER commit real values.
# ASP.NET Core reads nested settings from env vars with double underscores: Storage__Bucket -> Storage:Bucket

# ---- API (production) ----
ConnectionStrings__Archive=Host=...;Database=archive;Username=...;Password=...;SSL Mode=Require
Storage__Endpoint=https://s3.<region>.backblazeb2.com
Storage__Region=<region>
Storage__Bucket=<bucket-name>
Storage__AccessKeyId=<application key id>
Storage__SecretAccessKey=<application key>

# ---- CLI (your laptop) ----
ARCHIVE_API_URL=https://<your-api-host>
ARCHIVE_API_KEY=pa_...
# Generated by `archive keygen`. Also in your password manager AND on paper.
ARCHIVE_MASTER_KEY=

# ---- Replica (scripts/replicate.sh, via rclone) ----
RCLONE_CONFIG_PRIMARY_TYPE=s3
RCLONE_CONFIG_PRIMARY_PROVIDER=Other
RCLONE_CONFIG_PRIMARY_ENDPOINT=https://s3.<region>.backblazeb2.com
RCLONE_CONFIG_PRIMARY_ACCESS_KEY_ID=
RCLONE_CONFIG_PRIMARY_SECRET_ACCESS_KEY=
RCLONE_CONFIG_REPLICA_TYPE=s3
RCLONE_CONFIG_REPLICA_PROVIDER=Cloudflare
RCLONE_CONFIG_REPLICA_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
RCLONE_CONFIG_REPLICA_ACCESS_KEY_ID=
RCLONE_CONFIG_REPLICA_SECRET_ACCESS_KEY=
PRIMARY_BUCKET=
REPLICA_BUCKET=
