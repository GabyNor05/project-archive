<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Archive.Core holds the rules of the archive (what a project/asset/version is,
    how storage keys and paths are formed). It deliberately has ZERO package
    dependencies, so it never breaks when a library is abandoned and it can be
    tested without a database or cloud account.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
