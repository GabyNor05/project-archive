{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Archive": "Host=localhost;Port=5432;Database=archive;Username=archive;Password=archive-local-only"
  },

  "Storage": {
    "Endpoint": "http://localhost:9000",
    "Region": "us-east-1",
    "Bucket": "project-archive",
    "AccessKeyId": "set-via-env-Storage__AccessKeyId",
    "SecretAccessKey": "set-via-env-Storage__SecretAccessKey"
  },

  "Cors": {
    "Origins": [ "https://gabynor05.github.io", "http://localhost:5173" ]
  },

  "Uploads": {
    "MaxSingleUploadBytes": 5368709120,
    "RequireEncryptionForPrivate": true,
    "VerifyOnCompleteMaxBytes": 209715200
  },

  "Fixity": {
    "Enabled": true,
    "IntervalHours": 24,
    "BatchSize": 50,
    "ReverifyAfterDays": 30
  },

  "Database": {
    "MigrateOnStartup": true
  }
}
